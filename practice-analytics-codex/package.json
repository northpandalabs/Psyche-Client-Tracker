{
  "name": "practice-analytics-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first practice analytics desktop application",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretest": "npm rebuild better-sqlite3",
    "build": "electron-rebuild -f -w better-sqlite3 && tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:publish": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.54.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.practiceanalytics.desktop",
    "productName": "Practice Analytics",
    "icon": "build/icon.ico",
    "directories": {
      "output": "../Releases"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../legal/build_info.json",
        "to": "build_info.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Practice.Analytics.Setup.${version}.${ext}",
      "license": "../legal/eula.txt",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
